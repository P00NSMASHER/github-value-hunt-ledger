+++ b/tests/test_phase2_financial.py
@@ -0,0 +1,226 @@
+"""Phase 2 offline original StagingTwin adversarial and positive-path coverage."""
+from __future__ import annotations
+import copy
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+from unified.core import load_source,public_invoice
+from unified.customers import baseline_public_candidate,persona_for
+from unified.demo_fixtures import fictional_consent,SIMULATED_ISSUER_KEY
+from unified.fee_authority import create_fixture_terms
+from unified.staging import Rejected,StagingTwin
+
+
+class Phase2FinancialTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.rows=load_source(2000)
+
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.db=Path(self.tmp.name)/'phase2.sqlite'
+        self.tw=StagingTwin(self.db,fee_verifier_key=SIMULATED_ISSUER_KEY)
+        self.row=next(r for r in self.rows if int(r['invoice_total_cents'])>1500)
+        self.tenant='SIM-TENANT-001'
+        self.cid='SIM-CASE-PHASE2-1'
+        self.tw.create(self.row,self.tenant,self.cid)
+
+    def go(self,actor,kind,**payload):
+        return self.tw.act(self.cid,self.tenant,actor,kind,payload)
+
+    def state(self):return self.tw.view(self.cid,self.tenant)['funds']
+
+    def settlement(self,total=1000,consent=None):
+        self.go('buyer','CONSENT',**(consent or fictional_consent(self.row,self.tenant)))
+        self.go('operator','FREEZE',evidence_ref='SIM-EVIDENCE-FREEZE')
+        self.go('operator','CANDIDATE',amount_cents=total)
+        self.go('reviewer','REVIEW',amount_cents=total,evidence_ref='SIM-EVIDENCE-REVIEW')
+        self.go('buyer','AUTHORIZE',amount_cents=total,evidence_ref='SIM-EVIDENCE-APPROVE')
+        self.go('operator','SUBMIT')
+        self.go('carrier_mock','ACKNOWLEDGE')
+        self.go('carrier_mock','OFFER',amount_cents=total)
+        self.go('carrier_mock','SETTLE',amount_cents=total,evidence_ref='SIM-EVIDENCE-SETTLE')
+
+    def credit(self,amount,ref):
+        self.go('finance','CREDIT',amount_cents=amount,provider_ref=ref,evidence_ref='SIM-EVIDENCE-CREDIT')
+
+    def reconcile(self,amount,ref):
+        self.go('finance','RECONCILE',amount_cents=amount,credit_ref=ref,evidence_ref='SIM-EVIDENCE-RECONCILED')
+
+    def invoice_fee(self,rate=2000):
+        self.go('finance','FEE_INVOICE',fee_bps=rate,evidence_ref='SIM-EVIDENCE-FEE')
+
+    def test_01_blind_invoice_never_exposes_derived_answers(self):
+        view=public_invoice(self.row)
+        banned=('truth_state','expected_base_cents','expected_fuel_cents','expected_accessorial_cents',
+                'scenario','competing_rate_cents','duplicate_payment_cents','net_eligible_cents','base_rate_cents')
+        for name in banned:self.assertNotIn(name,view)
+        mutated=dict(self.row)
+        for name in ('expected_base_cents','expected_fuel_cents','expected_accessorial_cents','truth_state','net_eligible_cents'):
+            mutated[name] = '99999999' if name!='truth_state' else 'NEGATIVE'
+        self.assertEqual(baseline_public_candidate(self.row),baseline_public_candidate(mutated))
+
+    def test_02_unique_names_preserve_source_account(self):
+        names={persona_for({'customer_id':r['customer_id']})['name'] for r in self.rows}
+        self.assertEqual(len(names),len({r['customer_id'] for r in self.rows}))
+
+    def test_03_duplicate_economic_issue_blocked_but_distinct_issue_accepted(self):
+        with self.assertRaisesRegex(Rejected,'DUPLICATE_ECONOMIC_ISSUE'):
+            self.tw.create(self.row,self.tenant,'SIM-CASE-PHASE2-2')
+        self.tw.create(self.row,self.tenant,'SIM-CASE-PHASE2-3',issue_id='FUEL_DISCREPANCY')
+
+    def test_04_cross_tenant_source_owner_collision_rejected(self):
+        with self.assertRaisesRegex(Rejected,'SOURCE_ALREADY_SCOPED_TO_ANOTHER_TENANT'):
+            self.tw.create(self.row,'SIM-TENANT-002','SIM-CASE-FOREIGN')
+        wrong=dict(self.row);wrong['synthetic_source_sha256']='0'*64
+        with self.assertRaisesRegex(Rejected,'SOURCE_VERSION_BINDING_CHANGED'):
+            self.tw.create(wrong,self.tenant,'SIM-CASE-SOURCE-CHANGE',issue_id='OTHER_ISSUE')
+
+    def test_05_unbound_fee_and_false_signature_rejected(self):
+        self.settlement(consent={'scope_signed':True})
+        self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        with self.assertRaisesRegex(Rejected,'MISSING_VERSIONED_CONTRACT_TERMS'):
+            self.invoice_fee(5000)
+        self.assertEqual(self.state()['fee_earned'],0)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_06_tampered_fee_terms_or_wrong_signer_fails_at_consent(self):
+        consent=fictional_consent(self.row,self.tenant)
+        consent['terms']['fee_bps']=5000
+        with self.assertRaisesRegex(Rejected,'CONTRACT_SIGNATURE_MISMATCH'):
+            self.go('buyer','CONSENT',**consent)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_07_fee_rate_cannot_override_signed_fee(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        with self.assertRaisesRegex(Rejected,'FEE_RATE_NOT_CONTRACT_BOUND'):
+            self.invoice_fee(5000)
+        self.invoice_fee(2000)
+        self.assertEqual(self.state()['fee_earned'],200)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_08_expired_fee_terms_fail_closed(self):
+        terms=create_fixture_terms(signing_key=SIMULATED_ISSUER_KEY,tenant=self.tenant,
+            source_customer_id=self.row['customer_id'],fee_bps=2000,
+            valid_through='2026-02-01T00:00:00Z')
+        with self.assertRaisesRegex(Rejected,'CONTRACT_NOT_EFFECTIVE'):
+            self.go('buyer','CONSENT',scope_signed=True,terms=terms)
+
+    def test_09_two_partial_credits_reconcile_exactly(self):
+        self.settlement()
+        self.credit(400,'SIM-CREDIT-ONE')
+        self.reconcile(400,'SIM-CREDIT-ONE')
+        self.credit(600,'SIM-CREDIT-TWO')
+        self.reconcile(600,'SIM-CREDIT-TWO')
+        self.invoice_fee()
+        self.assertEqual(self.state()['received'],1000)
+        self.assertEqual(self.state()['realized'],1000)
+        self.assertEqual(self.state()['fee_earned'],200)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+        with self.assertRaisesRegex(Rejected,'CUMULATIVE_RECEIPT_EXCEEDS_SETTLEMENT'):
+            self.credit(1,'SIM-CREDIT-THREE')
+
+    def test_10_one_credit_in_multiple_remittance_instalments(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE')
+        self.reconcile(400,'SIM-CREDIT-ONE')
+        self.reconcile(600,'SIM-CREDIT-ONE')
+        self.assertEqual(self.state()['realized'],1000)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_11_duplicate_credit_reference_rejected(self):
+        self.settlement();self.credit(400,'SIM-CREDIT-ONE')
+        with self.assertRaisesRegex(Rejected,'DUPLICATE_CREDIT_REFERENCE'):
+            self.credit(600,'SIM-CREDIT-ONE')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_12_revoked_authorization_must_allow_corrective_refund(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        self.invoice_fee();self.go('finance','FEE_PAY',amount_cents=200,evidence_ref='SIM-EVIDENCE-PAY')
+        self.go('buyer','REVOKE')
+        self.go('finance','REVERSE',amount_cents=1000,credit_ref='SIM-CREDIT-ONE',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.state()['fee_earned'],0)
+        self.assertEqual(self.state()['fee_refund_due'],200)
+        self.go('finance','REFUND',amount_cents=200,evidence_ref='SIM-EVIDENCE-REFUND')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+        self.assertEqual(self.state()['realized'],0)
+        self.assertEqual(self.state()['fee_refund_due'],0)
+
+    def test_13_reverse_before_fee_collection_undoes_receivable(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        self.invoice_fee()
+        self.go('buyer','REVOKE')
+        self.go('finance','REVERSE',amount_cents=1000,credit_ref='SIM-CREDIT-ONE',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.state()['fee_earned'],0)
+        self.assertEqual(self.state()['fee_refund_due'],0)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_14_delayed_partial_reversal_after_two_credits_and_partial_fee(self):
+        self.settlement();self.credit(400,'SIM-CREDIT-ONE');self.reconcile(400,'SIM-CREDIT-ONE')
+        self.credit(600,'SIM-CREDIT-TWO');self.reconcile(600,'SIM-CREDIT-TWO')
+        self.invoice_fee();self.go('finance','FEE_PAY',amount_cents=150,evidence_ref='SIM-EVIDENCE-PAY')
+        self.go('buyer','REVOKE')
+        self.go('finance','REVERSE',amount_cents=500,credit_ref='SIM-CREDIT-TWO',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.state()['realized'],500)
+        self.assertEqual(self.state()['fee_earned'],100)
+        self.assertEqual(self.state()['fee_refund_due'],50)
+        self.go('finance','REFUND',amount_cents=50,evidence_ref='SIM-EVIDENCE-REFUND')
+        self.assertEqual(self.state()['fee_collected']-self.state()['fee_refunded'],100)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_15_reverse_pending_credit_does_not_erase_other_realized(self):
+        self.settlement();self.credit(500,'SIM-CREDIT-ONE');self.reconcile(500,'SIM-CREDIT-ONE')
+        self.credit(500,'SIM-CREDIT-TWO')
+        self.go('finance','REVERSE',amount_cents=250,credit_ref='SIM-CREDIT-TWO',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.state()['realized'],500)
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_16_reversal_must_not_steal_credit_from_another_reference(self):
+        self.settlement();self.credit(600,'SIM-CREDIT-ONE');self.credit(400,'SIM-CREDIT-TWO')
+        with self.assertRaisesRegex(Rejected,'REVERSAL_ABOVE_ORIGINAL_CREDIT'):
+            self.go('finance','REVERSE',amount_cents=650,credit_ref='SIM-CREDIT-ONE',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        with self.assertRaisesRegex(Rejected,'REVERSAL_REFERENCE_REQUIRED'):
+            self.go('finance','REVERSE',amount_cents=1,evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_17_close_blocked_until_fee_paid_or_written_off(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        self.invoice_fee()
+        with self.assertRaisesRegex(Rejected,'UNRESOLVED_FEE_RECEIVABLE'):
+            self.go('buyer','CLOSE')
+        with self.assertRaisesRegex(Rejected,'WRITE_OFF_REQUIRES_FINANCE_APPROVAL'):
+            self.go('finance','FEE_WRITE_OFF',amount_cents=200,evidence_ref='SIM-EVIDENCE-WRITEOFF')
+        self.go('finance','FEE_WRITE_OFF',amount_cents=200,evidence_ref='SIM-EVIDENCE-WRITEOFF',approved=True,approver='SIM-CONTROLLER')
+        self.go('buyer','CLOSE')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_18_written_off_fee_then_reversal_releases_writeoff(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        self.invoice_fee();self.go('finance','FEE_PAY',amount_cents=150,evidence_ref='SIM-EVIDENCE-PAY')
+        self.go('finance','FEE_WRITE_OFF',amount_cents=50,evidence_ref='SIM-EVIDENCE-WRITEOFF',approved=True,approver='SIM-CONTROLLER')
+        self.go('finance','REVERSE',amount_cents=1000,credit_ref='SIM-CREDIT-ONE',evidence_ref='SIM-EVIDENCE-REVERSAL')
+        self.assertEqual(self.state()['fee_written_off'],0)
+        self.assertEqual(self.state()['fee_refund_due'],150)
+        self.go('finance','REFUND',amount_cents=150,evidence_ref='SIM-EVIDENCE-REFUND')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+
+    def test_19_tampered_realized_amount_fails_independent_replay(self):
+        self.settlement();self.credit(1000,'SIM-CREDIT-ONE');self.reconcile(1000,'SIM-CREDIT-ONE')
+        self.assertEqual(self.tw.verify()['status'],'PASS_SYNTHETIC_ONLY')
+        with sqlite3.connect(self.db) as con:
+            import json
+            funds=json.loads(con.execute('SELECT funds_json FROM simulated_cases WHERE case_id=?',(self.cid,)).fetchone()[0])
+            funds['realized']+=500000
+            con.execute('UPDATE simulated_cases SET funds_json=? WHERE case_id=?',(json.dumps(funds),self.cid))
+        res=self.tw.verify()
+        self.assertEqual(res['status'],'FAIL')
+        self.assertTrue(any('FUND_REPLAY_MISMATCH' in x for x in res['errors']))
+
+    def test_20_wrong_currency_prohibited(self):
+        self.settlement()
+        with self.assertRaisesRegex(Rejected,'CURRENCY_SCOPE_MISMATCH'):
+            self.go('finance','CREDIT',amount_cents=1000,provider_ref='SIM-CREDIT-ONE',currency='EUR',evidence_ref='SIM-EVIDENCE-CREDIT')
+
+
+if __name__=='__main__':unittest.main()
