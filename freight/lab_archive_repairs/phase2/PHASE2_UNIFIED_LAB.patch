+"""Synthetic verifier-key-bound contract terms. NOT real electronic signatures.
+
+An issuer-held verification key must be injected, never stored in the SQLite lab.
+Independent third-party identity / customer consent remain unestablished.
+"""
+from __future__ import annotations
+import hashlib
+import hmac
+import json
+from datetime import datetime, timezone
+
+FIELDS = ('tenant', 'source_customer_id', 'agreement_id', 'version',
+          'fee_bps', 'currency', 'effective_from', 'valid_through', 'signer')
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False).encode()
+
+
+def utc(value):
+    if not isinstance(value, str):
+        raise ValueError('INVALID_TERM_DATE')
+    try:
+        when = datetime.fromisoformat(value.replace('Z', '+00:00'))
+    except ValueError as exc:
+        raise ValueError('INVALID_TERM_DATE') from exc
+    if not when.tzinfo or when.utcoffset() is None:
+        raise ValueError('INVALID_TERM_DATE')
+    return when.astimezone(timezone.utc)
+
+
+def create_fixture_terms(*, signing_key, tenant, source_customer_id, fee_bps=2000,
+                         agreement_id='SIM-CONTRACT-1', version=1,
+                         effective_from='2026-01-01T00:00:00Z',
+                         valid_through='2027-01-01T00:00:00Z', signer='SIM-EXTERNAL-ISSUER'):
+    """For deterministic offline testing only. Not a real buyer signature."""
+    body = dict(tenant=tenant, source_customer_id=source_customer_id,
+                agreement_id=agreement_id, version=version, fee_bps=fee_bps,
+                currency='USD', effective_from=effective_from,
+                valid_through=valid_through, signer=signer)
+    return {**body, 'signature': hmac.new(signing_key, canonical(body), hashlib.sha256).hexdigest()}
+
+
+def check_terms(terms, *, verifier_key, tenant, source_customer_id,
+                currency='USD', as_of='2026-10-08T00:00:00Z'):
+    if not verifier_key or not isinstance(verifier_key, bytes) or len(verifier_key) < 16:
+        raise ValueError('NO_SEPARATE_CONTRACT_VERIFICATION_KEY')
+    if not isinstance(terms, dict) or set(terms) != set(FIELDS) | {'signature'}:
+        raise ValueError('MISSING_VERSIONED_CONTRACT_TERMS')
+    if (terms['tenant'], terms['source_customer_id'], terms['currency']) != (tenant, source_customer_id, currency):
+        raise ValueError('CONTRACT_SCOPE_MISMATCH')
+    if type(terms['fee_bps']) is not int or not 0 <= terms['fee_bps'] <= 5000:
+        raise ValueError('INVALID_AUTHORIZED_FEE_RATE')
+    if type(terms['version']) is not int or terms['version'] < 1:
+        raise ValueError('INVALID_CONTRACT_VERSION')
+    if not all(isinstance(terms[k], str) and terms[k].startswith('SIM-') for k in ('agreement_id', 'signer')):
+        raise ValueError('UNVERIFIED_CONTRACT_IDENTITY')
+    if not utc(terms['effective_from']) <= utc(as_of) < utc(terms['valid_through']):
+        raise ValueError('CONTRACT_NOT_EFFECTIVE')
+    expected = hmac.new(verifier_key, canonical({k: terms[k] for k in FIELDS}), hashlib.sha256).hexdigest()
+    if not isinstance(terms['signature'], str) or not hmac.compare_digest(expected, terms['signature']):
+        raise ValueError('CONTRACT_SIGNATURE_MISMATCH')
+    return terms['fee_bps']
