{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V16 Worker Activation",
  "type": "object",
  "required": [
    "activation_id",
    "activation_generation_id",
    "worker_id",
    "slot_id",
    "dispatch_ticket_id",
    "presence_generation_id",
    "presence_event_id",
    "issued_at",
    "expires_at",
    "dispatch_kind"
  ],
  "properties": {
    "activation_id": {
      "type": "string",
      "pattern": "^ACTIVATE:[a-f0-9]{12}$"
    },
    "activation_generation_id": {
      "type": "string",
      "pattern": "^ACTGEN:[a-f0-9]{12}$"
    },
    "worker_id": {
      "type": "string"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^SLOT-[0-9]{2}$"
    },
    "dispatch_ticket_id": {
      "type": "string",
      "pattern": "^DISPATCH:[a-f0-9]{12}$"
    },
    "dispatch_generation_id": {
      "type": "string",
      "pattern": "^DISPATCHGEN:[a-f0-9]{12}$"
    },
    "dispatch_kind": {
      "enum": [
        "primary",
        "work_steal"
      ]
    },
    "dispatch_parent_ticket_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "presence_generation_id": {
      "type": "string",
      "pattern": "^PRESENCEGEN:[a-f0-9]{12}$"
    },
    "presence_event_id": {
      "type": "string",
      "pattern": "^PRESENCE:[a-f0-9]{12}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "activation_status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
