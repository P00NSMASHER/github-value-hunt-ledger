{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Adjacency Hypothesis",
  "type": "object",
  "required": [
    "adjacency_id",
    "adjacency_type",
    "priority",
    "root_repository",
    "strategy_id",
    "search_objective_id",
    "why_expand",
    "search_recipe",
    "query_templates",
    "verification_gate",
    "stop_conditions",
    "performance"
  ],
  "properties": {
    "adjacency_id": {
      "type": "string",
      "pattern": "^ADJ:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "adjacency_type": {
      "enum": [
        "organization_siblings",
        "contributor_lineage",
        "fork_descendants",
        "dependency_upstream",
        "consumer_downstream",
        "distinctive_symbol",
        "commit_lineage"
      ]
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "root_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "root_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_source": {
      "type": "string"
    },
    "root_status": {
      "type": "string"
    },
    "root_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "search_objective_id": {
      "type": "string",
      "pattern": "^OBJ:[a-z0-9-]+$"
    },
    "why_expand": {
      "type": "string",
      "minLength": 1
    },
    "load_bearing_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_recipe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "query_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_gate": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude_same_domain": {
      "type": "boolean"
    },
    "performance": {
      "type": "object"
    },
    "type_performance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
