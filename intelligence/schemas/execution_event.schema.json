{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V11 Hunt Execution Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "slot_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EXEC:[a-f0-9]{12}$"
    },
    "event_type": {
      "enum": [
        "CLAIM",
        "HEARTBEAT",
        "START",
        "COMPLETE",
        "FAIL",
        "RELEASE"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^SLOT-[0-9]{2}$"
    },
    "claim_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CLAIM:[a-f0-9]{12}$"
    },
    "worker_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{2,64}$"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "allocator_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ALLOCGEN:[a-f0-9]{12}$"
    },
    "portfolio_policy_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PORTFOLIO:[a-f0-9]{12}$"
    },
    "work_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^WORK:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "assignment_slot_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_work_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "lease_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "extend_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "search_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "retryable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ROUTING:[a-f0-9]{12}$"
    },
    "worker_profile_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^WORKERS:[a-f0-9]{12}$"
    },
    "routing_score": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
