{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hunter Learning Failure v1",
  "type": "object",
  "required": [
    "schema_version",
    "failure_id",
    "run_id",
    "hunter_id",
    "target_type",
    "target_id",
    "failure_class",
    "observation",
    "reproduction_steps",
    "evidence_refs",
    "proposed_regression_test",
    "sensitive_material_involved",
    "benchmark_contaminated"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "failure_id": {
      "type": "string",
      "pattern": "^FAIL:[A-Za-z0-9:_-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "hunter_id": {
      "type": "string",
      "minLength": 2
    },
    "target_type": {
      "enum": [
        "search_skill",
        "query_family",
        "search_move",
        "tool",
        "prompt",
        "workflow",
        "routing",
        "memory",
        "harness"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "enum": [
        "false_positive",
        "false_negative",
        "duplicate_work",
        "retrieval_failure",
        "evidence_failure",
        "tool_failure",
        "prompt_failure",
        "workflow_failure",
        "regression",
        "overfit",
        "transfer_failure",
        "other"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 10
    },
    "reproduction_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_regression_test": {
      "type": "string",
      "minLength": 10
    },
    "sensitive_material_involved": {
      "type": "boolean"
    },
    "benchmark_contaminated": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "SUBMITTED",
        "QUEUED",
        "BLOCKED",
        "REPAIRING",
        "READY_FOR_SKILL_EVAL",
        "CLOSED"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
