{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hunter Repair Candidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "repair_candidate_id",
    "repair_task_id",
    "repair_task_sha256",
    "target_type",
    "target_id",
    "artifact_id",
    "baseline_version",
    "candidate_version",
    "baseline_artifact_ref",
    "candidate_artifact_ref",
    "diff_hash",
    "changed_logical_targets",
    "regression_tests_total",
    "regression_tests_passed",
    "regression_test_evidence_refs",
    "decision_history_ref",
    "unrelated_files_changed",
    "sensitive_material_involved",
    "benchmark_contaminated"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repair_candidate_id": {
      "type": "string",
      "pattern": "^RCAND:[A-Za-z0-9:_-]+$"
    },
    "repair_task_id": {
      "type": "string",
      "pattern": "^REPAIR:[A-Za-z0-9:_-]+$"
    },
    "repair_task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_type": {
      "enum": [
        "search_skill",
        "query_family",
        "search_move",
        "tool",
        "prompt",
        "workflow",
        "routing",
        "memory",
        "harness"
      ]
    },
    "target_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "baseline_artifact_ref": {"type": "string", "minLength": 1},
    "candidate_artifact_ref": {"type": "string", "minLength": 1},
    "diff_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_logical_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "regression_tests_total": {"type": "integer", "minimum": 1},
    "regression_tests_passed": {"type": "integer", "minimum": 0},
    "regression_test_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_history_ref": {"type": "string", "minLength": 1},
    "unrelated_files_changed": {"type": "boolean"},
    "sensitive_material_involved": {"type": "boolean"},
    "benchmark_contaminated": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
