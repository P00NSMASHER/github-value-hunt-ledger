{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Coverage Profile",
  "type": "object",
  "required": [
    "repository",
    "metadata_status",
    "source_type",
    "package_ecosystems",
    "protocol_families",
    "geography_tags",
    "technology_domains"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata_status": {
      "enum": [
        "observed",
        "unavailable"
      ]
    },
    "stars": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "forks_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "primary_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "archived": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "fork": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "pushed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license_spdx": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "company",
        "government",
        "university",
        "national_lab",
        "standards_body",
        "nonprofit",
        "community",
        "individual",
        "unknown"
      ]
    },
    "package_ecosystems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocol_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geography_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technology_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_source": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
