{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Research Neighborhood",
  "type": "object",
  "required": [
    "neighborhood_id",
    "neighborhood_type",
    "label",
    "status",
    "saturation_score",
    "recommended_action",
    "runs",
    "deep_inspected",
    "retained_count",
    "master_promoted_count",
    "sufficient_evidence"
  ],
  "properties": {
    "neighborhood_id": {
      "type": "string",
      "pattern": "^NBR:[a-z0-9-]+:.+"
    },
    "neighborhood_type": {
      "enum": [
        "capability",
        "query_family",
        "search_objective",
        "adjacency_type",
        "adjacency_root",
        "search_seed"
      ]
    },
    "label": {
      "type": "string"
    },
    "status": {
      "enum": [
        "INSUFFICIENT",
        "PRODUCTIVE",
        "BALANCED",
        "SATURATING",
        "SATURATED"
      ]
    },
    "saturation_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "recommended_action": {
      "enum": [
        "MEASURE_MORE",
        "CONTINUE_BOUNDED",
        "CONTINUE_WITH_DIVERSITY",
        "DIVERSIFY_SURFACE_OR_ADJACENCY",
        "SHIFT_TO_EXPERIMENT_OR_UNDEREXPLORED_NEIGHBORHOOD"
      ]
    },
    "runs": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "deep_inspected": {
      "type": "integer",
      "minimum": 0
    },
    "retained_count": {
      "type": "integer",
      "minimum": 0
    },
    "master_promoted_count": {
      "type": "integer",
      "minimum": 0
    },
    "new_capability_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "experiment_run_count": {
      "type": "integer",
      "minimum": 0
    },
    "retained_precision": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "master_yield": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "new_capability_run_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "duplicate_ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "first_seen_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "average_novelty_ordinal": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 5
    },
    "trailing_no_delta_runs": {
      "type": "integer",
      "minimum": 0
    },
    "recent_retained_precision": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "sufficient_evidence": {
      "type": "boolean"
    },
    "capability_gap_score": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
