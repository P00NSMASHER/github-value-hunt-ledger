{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V14 Routing Decision Audit Record",
  "type": "object",
  "required": [
    "routing_decision_audit_generation_id",
    "decision_id",
    "routing_generation_id",
    "worker_id",
    "slot_id",
    "assignment_id",
    "chosen_score",
    "global_optimal_score",
    "counterfactual_feasible",
    "worker_candidate_count",
    "slot_candidate_count"
  ],
  "properties": {
    "routing_decision_audit_generation_id": {
      "type": "string",
      "pattern": "^ROUTEAUDIT:[a-f0-9]{12}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^ROUTEDEC:[a-f0-9]{12}$"
    },
    "routing_generation_id": {
      "type": "string",
      "pattern": "^ROUTING:[a-f0-9]{12}$"
    },
    "worker_profile_generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "routing_learning_generation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_id": {
      "type": "string",
      "pattern": "^HUNTER-(0[1-9]|1[0-4])$"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^SLOT-[0-9]{2}$"
    },
    "assignment_id": {
      "type": "string"
    },
    "chosen_score": {
      "type": "number"
    },
    "global_optimal_score": {
      "type": "number"
    },
    "global_alternative_score_without_pair": {
      "type": [
        "number",
        "null"
      ]
    },
    "global_pair_criticality": {
      "type": [
        "number",
        "null"
      ]
    },
    "counterfactual_feasible": {
      "type": "boolean"
    },
    "counterfactual_pairs": {
      "type": "array"
    },
    "worker_next_best_slot": {
      "type": [
        "string",
        "null"
      ]
    },
    "worker_next_best_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "worker_local_delta": {
      "type": [
        "number",
        "null"
      ]
    },
    "slot_next_best_worker": {
      "type": [
        "string",
        "null"
      ]
    },
    "slot_next_best_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "slot_local_delta": {
      "type": [
        "number",
        "null"
      ]
    },
    "worker_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "slot_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "worker_score_rank": {
      "type": "integer",
      "minimum": 1
    },
    "slot_score_rank": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
