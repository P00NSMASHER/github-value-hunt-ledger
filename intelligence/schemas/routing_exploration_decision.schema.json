{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V18 Controlled Routing Exploration Decision",
  "type": "object",
  "required": [
    "exploration_generation_id",
    "seed_hash",
    "gate_value",
    "exploration_probability",
    "baseline_total_score",
    "applied",
    "reason",
    "absolute_regret",
    "relative_regret",
    "measurement_need",
    "candidate_count",
    "routing_generation_id"
  ],
  "properties": {
    "exploration_generation_id": {
      "type": "string",
      "pattern": "^ROUTEEXP:[a-f0-9]{12}$"
    },
    "seed_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "exploration_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "baseline_total_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "applied": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EXPPAIR:[a-f0-9]{12}$"
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_slots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SLOT-[0-9]{2}$"
      }
    },
    "exploration_slots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SLOT-[0-9]{2}$"
      }
    },
    "match_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3
    },
    "match_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "absolute_regret": {
      "type": "number",
      "minimum": 0
    },
    "relative_regret": {
      "type": "number",
      "minimum": 0
    },
    "measurement_need": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "routing_generation_id": {
      "type": "string",
      "pattern": "^ROUTING:[a-f0-9]{12}$"
    },
    "worker_profile_generation_id": {
      "type": "string",
      "pattern": "^WORKERS:[a-f0-9]{12}$"
    },
    "routing_learning_generation_id": {
      "type": "string",
      "pattern": "^ROUTELEARN:[a-f0-9]{12}$"
    },
    "activation_response_learning_generation_id": {
      "type": "string",
      "pattern": "^RESPLEARN:[a-f0-9]{12}$"
    }
  },
  "additionalProperties": true
}
