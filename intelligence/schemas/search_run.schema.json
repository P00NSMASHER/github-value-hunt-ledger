{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Search Run",
  "type": "object",
  "required": [
    "search_run_id",
    "timestamp",
    "hunter_role",
    "strategy_id",
    "query_family",
    "measurement_quality",
    "search_surfaces",
    "queries"
  ],
  "properties": {
    "search_run_id": {
      "type": "string",
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "hunter_role": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "query_family": {
      "type": "string",
      "minLength": 1
    },
    "measurement_quality": {
      "enum": [
        "prospective",
        "benchmark",
        "retrospective"
      ]
    },
    "lane_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "deep_inspected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retained_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "master_promoted_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "new_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "strengthened_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "master",
              "strong",
              "watch",
              "rejected",
              "quarantined"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
