{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Search Run v16",
  "type": "object",
  "required": [
    "search_run_id",
    "strategy_id",
    "query_family",
    "measurement_quality",
    "candidate_count",
    "deep_inspected",
    "retained_count",
    "master_promoted_count"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2
    },
    "search_run_id": {
      "type": "string",
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "query_family": {
      "type": "string",
      "minLength": 1
    },
    "measurement_quality": {
      "enum": [
        "prospective",
        "benchmark",
        "retrospective"
      ]
    },
    "work_action": {
      "description": "Actual action classification. Explicit non-search or unknown actions are excluded from discovery-yield learning; missing legacy fields retain historical observational meaning.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "search",
        "verify_artifact",
        "execute_fixture",
        "await_external",
        null
      ]
    },
    "lane_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "deep_inspected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retained_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "master_promoted_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "recall_rescue_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "strengthened_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "novelty_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "evidence_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "replacement_days_low": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "replacement_days_high": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "reason_code_standard": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_seen_in_registry": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "repository_profile": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metadata_status": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              },
              "stars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "forks_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "primary_language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "archived": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "fork": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pushed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "license_spdx": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_type": {
                "enum": [
                  "company",
                  "government",
                  "university",
                  "national_lab",
                  "standards_body",
                  "nonprofit",
                  "community",
                  "individual",
                  "unknown"
                ]
              },
              "package_ecosystems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "protocol_families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "geography_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "technology_domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profile_source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "best_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "durable_evidence_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_family_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^QF:[a-z0-9-]+$"
    },
    "search_objective_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OBJ:[a-z0-9-]+$"
    },
    "benchmark_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      }
    },
    "comparison_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP:[A-Za-z0-9:_-]+$"
    },
    "evaluation_set_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVAL:[a-z0-9-]+$"
    },
    "seed_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual_hypothesis",
        "free_exploration",
        null
      ]
    },
    "seed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SEED:[a-z0-9:-]+$"
      }
    },
    "adjacency_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual",
        "none",
        null
      ]
    },
    "adjacency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADJ:[a-z0-9-]+:[a-z0-9-]+$"
      }
    },
    "adjacency_types": {
      "type": "array",
      "items": {
        "enum": [
          "organization_siblings",
          "contributor_lineage",
          "fork_descendants",
          "dependency_upstream",
          "consumer_downstream",
          "distinctive_symbol",
          "commit_lineage"
        ]
      }
    },
    "adjacency_root_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual",
        "none",
        null
      ]
    },
    "coverage_gap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^COV:[a-z0-9-]+:[a-z0-9-]+$"
      }
    },
    "allocation_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual_override",
        "unallocated",
        null
      ]
    },
    "allocator_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ALLOCGEN:[a-f0-9]{12}$"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ASSIGN:[a-f0-9]{12}:slot-[0-9]{2}$"
    },
    "assignment_work_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^WORK:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "portfolio_policy_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PORTFOLIO:[a-f0-9]{12}$"
    },
    "assignment_slot_role": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "experiment",
        "coverage",
        "adjacency",
        "measurement",
        "verification",
        "wildcard",
        null
      ]
    },
    "assignment_work_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_source_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "assignment_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "execution_claim_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CLAIM:[a-f0-9]{12}$"
    },
    "execution_slot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SLOT-[0-9]{2}$"
    },
    "execution_worker_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{2,64}$"
    },
    "routing_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual_override",
        "unrouted",
        null
      ]
    },
    "routing_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ROUTING:[a-f0-9]{12}$"
    },
    "worker_profile_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^WORKERS:[a-f0-9]{12}$"
    },
    "routing_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "dispatch_ticket_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DISPATCH:[a-f0-9]{12}$"
    },
    "dispatch_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DISPATCHGEN:[a-f0-9]{12}$"
    },
    "routing_learning_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ROUTELEARN:[a-f0-9]{12}$"
    },
    "route_override_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "primary",
        "work_steal",
        null
      ]
    },
    "dispatch_parent_ticket_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^DISPATCH:[a-f0-9]{12}$"
    },
    "presence_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PRESENCEGEN:[a-f0-9]{12}$"
    },
    "presence_event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PRESENCE:[a-f0-9]{12}$"
    },
    "activation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ACTIVATE:[a-f0-9]{12}$"
    },
    "activation_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ACTGEN:[a-f0-9]{12}$"
    },
    "stop_reason_standard": {
      "description": "Controlled terminal reason for observe-first recall/coordination learning. This does not by itself prove strategy quality.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "qualified_find",
        "duplicate_no_delta",
        "retrieval_limited",
        "no_qualifying_candidate",
        "evidence_blocked",
        "rights_or_safety_blocked",
        "external_prerequisite",
        "budget_exhausted",
        "completed_nonsearch",
        "other_or_unknown",
        null
      ]
    },
    "coordination_signal_ids": {
      "description": "Immutable cross-hunter coordination signals emitted by this run, when any.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SIG:[A-Za-z0-9:_-]+$"
      }
    },
    "consumed_coordination_signal_ids": {
      "description": "Cross-hunter coordination signals materially used to choose, narrow, falsify, or redirect this run.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SIG:[A-Za-z0-9:_-]+$"
      }
    },
    "recall_rescue_type": {
      "description": "Materially different retrieval move used for the final recall rescue, when any.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "surface_shift",
        "anchor_shift",
        "lineage_shift",
        "organization_graph",
        "adjacent_domain_invariant",
        "other",
        null
      ]
    },
    "recall_rescue_found_qualifying_candidate": {
      "description": "Whether the materially different recall rescue surfaced a candidate that satisfied the assignment acceptance target.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "search_moves": {
      "description": "Observed retrieval moves within a discovery run. Enables learning below whole-run/query-family granularity.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "move_type",
          "result"
        ],
        "properties": {
          "move_type": {
            "type": "string",
            "enum": [
              "direct_domain_search",
              "code_signature_search",
              "official_source_trace",
              "organization_graph",
              "contributor_or_commit_lineage",
              "paper_to_code_lineage",
              "package_or_dependency_graph",
              "adjacent_domain_invariant",
              "independent_comparator",
              "history_archaeology",
              "other"
            ]
          },
          "surface": {
            "type": [
              "string",
              "null"
            ]
          },
          "query_or_action": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "qualifying_hit",
              "useful_hit",
              "weak_hit",
              "no_hit",
              "retrieval_limited",
              "blocked",
              "unknown"
            ]
          },
          "candidate_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "deep_inspected": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "retained_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "candidate_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "candidate_preflight_checks": {
      "description": "Repository/revision/capability duplicate checks performed before expensive inspection.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "known_candidate_preflight_hits": {
      "description": "Preflight checks that found relevant prior evidence for the candidate identity.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "duplicate_deep_inspections_avoided": {
      "description": "Deep inspections intentionally skipped because current prior evidence made them redundant for the assignment.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "learning_measurement_packet_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^LMP:[a-f0-9]{16}$"
    },
    "learning_measurement_packet_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "query_family_id",
          "search_objective_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          },
          "measurement_quality": {
            "const": "benchmark"
          }
        },
        "required": [
          "schema_version",
          "measurement_quality"
        ]
      },
      "then": {
        "required": [
          "benchmark_task_ids",
          "comparison_group_id",
          "evaluation_set_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 5
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "seed_mode",
          "seed_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 6
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "adjacency_mode",
          "adjacency_ids",
          "adjacency_types",
          "adjacency_root_nodes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 8
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "coverage_mode",
          "coverage_gap_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 9
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "allocation_mode",
          "allocator_generation_id",
          "assignment_id",
          "assignment_work_item_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 10
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "portfolio_policy_generation_id",
          "assignment_slot_role",
          "assignment_work_kind",
          "assignment_source_id",
          "assignment_score"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 11
          },
          "allocation_mode": {
            "enum": [
              "generated",
              "manual_override"
            ]
          }
        },
        "required": [
          "schema_version",
          "allocation_mode"
        ]
      },
      "then": {
        "required": [
          "execution_claim_id",
          "execution_slot_id",
          "execution_worker_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 12
          },
          "allocation_mode": {
            "enum": [
              "generated",
              "manual_override"
            ]
          },
          "routing_mode": {
            "const": "generated"
          }
        },
        "required": [
          "schema_version",
          "allocation_mode",
          "routing_mode"
        ]
      },
      "then": {
        "required": [
          "routing_mode",
          "routing_generation_id",
          "worker_profile_generation_id",
          "routing_score"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 14
          },
          "routing_mode": {
            "const": "generated"
          }
        },
        "required": [
          "schema_version",
          "routing_mode"
        ]
      },
      "then": {
        "required": [
          "dispatch_ticket_id",
          "dispatch_generation_id",
          "routing_learning_generation_id",
          "routing_generation_id",
          "worker_profile_generation_id",
          "routing_score"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 14
          },
          "routing_mode": {
            "const": "manual_override"
          }
        },
        "required": [
          "schema_version",
          "routing_mode"
        ]
      },
      "then": {
        "required": [
          "route_override_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 15
          },
          "routing_mode": {
            "const": "generated"
          }
        },
        "required": [
          "schema_version",
          "routing_mode"
        ]
      },
      "then": {
        "required": [
          "dispatch_kind"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 15
          },
          "dispatch_kind": {
            "const": "work_steal"
          }
        },
        "required": [
          "schema_version",
          "dispatch_kind"
        ]
      },
      "then": {
        "required": [
          "dispatch_parent_ticket_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 16
          },
          "routing_mode": {
            "const": "generated"
          }
        },
        "required": [
          "schema_version",
          "routing_mode"
        ]
      },
      "then": {
        "required": [
          "presence_generation_id",
          "presence_event_id",
          "activation_id",
          "activation_generation_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "assignment_work_kind": {
            "const": "learning_measurement"
          }
        },
        "required": [
          "assignment_work_kind"
        ]
      },
      "then": {
        "required": [
          "learning_measurement_packet_id",
          "learning_measurement_packet_sha256"
        ],
        "properties": {
          "learning_measurement_packet_id": {
            "type": "string",
            "pattern": "^LMP:[a-f0-9]{16}$"
          },
          "learning_measurement_packet_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
