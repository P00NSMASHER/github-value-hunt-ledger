{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Search Run v9",
  "type": "object",
  "required": [
    "search_run_id",
    "strategy_id",
    "query_family",
    "measurement_quality",
    "candidate_count",
    "deep_inspected",
    "retained_count",
    "master_promoted_count"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2
    },
    "search_run_id": {
      "type": "string",
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "query_family": {
      "type": "string",
      "minLength": 1
    },
    "measurement_quality": {
      "enum": [
        "prospective",
        "benchmark",
        "retrospective"
      ]
    },
    "lane_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "deep_inspected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retained_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "master_promoted_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "recall_rescue_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "strengthened_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "novelty_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "evidence_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "replacement_days_low": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "replacement_days_high": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "reason_code_standard": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_seen_in_registry": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "repository_profile": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "metadata_status": {
                "enum": [
                  "observed",
                  "unavailable"
                ]
              },
              "stars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "forks_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "primary_language": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "archived": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "fork": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "updated_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pushed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "owner_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "license_spdx": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_type": {
                "enum": [
                  "company",
                  "government",
                  "university",
                  "national_lab",
                  "standards_body",
                  "nonprofit",
                  "community",
                  "individual",
                  "unknown"
                ]
              },
              "package_ecosystems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "protocol_families": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "geography_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "technology_domains": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "profile_source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "best_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "durable_evidence_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_family_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^QF:[a-z0-9-]+$"
    },
    "search_objective_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OBJ:[a-z0-9-]+$"
    },
    "benchmark_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      }
    },
    "comparison_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP:[A-Za-z0-9:_-]+$"
    },
    "evaluation_set_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVAL:[a-z0-9-]+$"
    },
    "seed_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual_hypothesis",
        "free_exploration",
        null
      ]
    },
    "seed_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SEED:[a-z0-9:-]+$"
      }
    },
    "adjacency_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual",
        "none",
        null
      ]
    },
    "adjacency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADJ:[a-z0-9-]+:[a-z0-9-]+$"
      }
    },
    "adjacency_types": {
      "type": "array",
      "items": {
        "enum": [
          "organization_siblings",
          "contributor_lineage",
          "fork_descendants",
          "dependency_upstream",
          "consumer_downstream",
          "distinctive_symbol",
          "commit_lineage"
        ]
      }
    },
    "adjacency_root_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual",
        "none",
        null
      ]
    },
    "coverage_gap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^COV:[a-z0-9-]+:[a-z0-9-]+$"
      }
    },
    "allocation_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generated",
        "manual_override",
        "unallocated",
        null
      ]
    },
    "allocator_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ALLOCGEN:[a-f0-9]{12}$"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ASSIGN:[a-f0-9]{12}:slot-[0-9]{2}$"
    },
    "assignment_work_item_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^WORK:[a-z0-9-]+:[a-z0-9-]+$"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "query_family_id",
          "search_objective_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          },
          "measurement_quality": {
            "const": "benchmark"
          }
        },
        "required": [
          "schema_version",
          "measurement_quality"
        ]
      },
      "then": {
        "required": [
          "benchmark_task_ids",
          "comparison_group_id",
          "evaluation_set_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 5
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "seed_mode",
          "seed_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 6
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "adjacency_mode",
          "adjacency_ids",
          "adjacency_types",
          "adjacency_root_nodes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 8
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "coverage_mode",
          "coverage_gap_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 9
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "allocation_mode",
          "allocator_generation_id",
          "assignment_id",
          "assignment_work_item_id"
        ]
      }
    }
  ]
}
