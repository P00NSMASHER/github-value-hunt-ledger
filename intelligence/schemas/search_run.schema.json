{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Search Run v4",
  "type": "object",
  "required": [
    "search_run_id",
    "strategy_id",
    "query_family",
    "measurement_quality",
    "candidate_count",
    "deep_inspected",
    "retained_count",
    "master_promoted_count"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2
    },
    "search_run_id": {
      "type": "string",
      "pattern": "^RUN:[A-Za-z0-9:_-]+$"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "hunter": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "query_family": {
      "type": "string",
      "minLength": 1
    },
    "measurement_quality": {
      "enum": [
        "prospective",
        "benchmark",
        "retrospective"
      ]
    },
    "lane_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "deep_inspected": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retained_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "master_promoted_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tool_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "recall_rescue_used": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "strengthened_capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "status"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "novelty_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "evidence_ordinal": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          },
          "replacement_days_low": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "replacement_days_high": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "reason_code_standard": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "duplicate_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_seen_in_registry": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "best_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "durable_evidence_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_family_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^QF:[a-z0-9-]+$"
    },
    "search_objective_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OBJ:[a-z0-9-]+$"
    },
    "benchmark_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      }
    },
    "comparison_group_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CMP:[A-Za-z0-9:_-]+$"
    },
    "evaluation_set_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^EVAL:[a-z0-9-]+$"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "query_family_id",
          "search_objective_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "minimum": 4
          },
          "measurement_quality": {
            "const": "benchmark"
          }
        },
        "required": [
          "schema_version",
          "measurement_quality"
        ]
      },
      "then": {
        "required": [
          "benchmark_task_ids",
          "comparison_group_id",
          "evaluation_set_id"
        ]
      }
    }
  ]
}
