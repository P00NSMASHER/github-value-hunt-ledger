{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technology Intelligence Search Seed",
  "type": "object",
  "required": [
    "seed_id",
    "seed_type",
    "priority",
    "strategy_id",
    "search_objective_id",
    "why_now",
    "required_signatures",
    "query_templates",
    "search_surfaces",
    "verification_gate",
    "stop_conditions",
    "authorization_basis",
    "performance"
  ],
  "properties": {
    "seed_id": {
      "type": "string",
      "pattern": "^SEED:[a-z0-9:-]+$"
    },
    "seed_type": {
      "enum": [
        "capability_gap",
        "positive_dna_transfer",
        "strategy_measurement"
      ]
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^STRAT:[a-z0-9-]+$"
    },
    "search_objective_id": {
      "type": "string",
      "pattern": "^OBJ:[a-z0-9-]+$"
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CAP-[0-9]{3,}$"
      }
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EXP-[0-9]{3,}$"
      }
    },
    "source_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "why_now": {
      "type": "string",
      "minLength": 1
    },
    "required_signatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "query_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "search_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_gate": {
      "type": "string",
      "minLength": 1
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization_basis": {
      "type": "string",
      "minLength": 1
    },
    "exclude_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "performance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
