{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-brain.local/schemas/portfolio-build-state.schema.json",
  "title": "Portfolio Brain Durable Build State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_version",
    "state_id",
    "working_branch",
    "phase",
    "current_step",
    "completed_steps",
    "repositories",
    "decisions",
    "artifacts",
    "tests",
    "blockers",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "architecture_version": {
      "type": "string",
      "minLength": 1
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "working_branch": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "parallel_prework",
        "architecture_build",
        "canary",
        "operational"
      ]
    },
    "current_step": {
      "type": "integer",
      "minimum": 0
    },
    "completed_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "full_name",
          "last_inspected_sha",
          "inspection_status"
        ],
        "properties": {
          "full_name": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "last_inspected_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "inspection_status": {
            "type": "string",
            "enum": [
              "UNINSPECTED",
              "UNCHANGED",
              "CHANGED",
              "INSPECTED",
              "ERROR"
            ]
          },
          "last_observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "summary",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PROVISIONAL",
              "ACCEPTED",
              "SUPERSEDED",
              "REJECTED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "step"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "step"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIP",
              "PENDING"
            ]
          },
          "step": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocker_id",
          "summary",
          "status"
        ],
        "properties": {
          "blocker_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "RESOLVED",
              "DEFERRED"
            ]
          },
          "requires_human_decision": {
            "type": "boolean"
          }
        }
      }
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "step",
        "summary",
        "preconditions"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
