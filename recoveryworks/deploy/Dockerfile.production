FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ARG RECOVERYWORKS_VCS_REF
LABEL org.opencontainers.image.title="RecoveryWorks Cloud Pilot"
LABEL org.opencontainers.image.revision="${RECOVERYWORKS_VCS_REF}"
LABEL org.opencontainers.image.base.name="python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0

WORKDIR /app

COPY recoveryworks/requirements.production.lock /app/recoveryworks/requirements.production.lock
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
    -r /app/recoveryworks/requirements.production.lock

COPY recoveryworks /app/recoveryworks
COPY freight /app/freight

RUN python -m compileall -q /app/recoveryworks /app/freight \
    && python -c "import recoveryworks; import recoveryworks.pilot_runner; import recoveryworks.production_deployment"

USER 65532:65532

ENTRYPOINT ["python", "-m", "recoveryworks.pilot_runner"]
CMD ["--help"]
